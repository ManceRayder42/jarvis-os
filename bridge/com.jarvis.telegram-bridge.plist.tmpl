<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jarvis.telegram-bridge</string>

  <!-- Starts the bridge at login if it isn't already running. The script
       itself is idempotent (exits 0 immediately if the tmux session already
       exists), so RunAtLoad-only with no KeepAlive is correct here — the
       ongoing supervision (restart on crash, deaf-bridge recovery) is
       telegram-watchdog.sh's job, not this plist's. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__CLAUDE_PLUGIN_ROOT__/bridge/telegram-bridge.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>

  <key>StandardOutPath</key><string>__HOME__/Library/Logs/jarvis-telegram-bridge-launch.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/jarvis-telegram-bridge-launch.log</string>

  <!-- Optional: uncomment and set if you want this plist to pin a hub that
       differs from ~/.jarvis-hub-path (the file /jarvis-setup writes). Most
       installs don't need this — the scripts already read that pointer file
       directly, and launchd jobs don't inherit your shell profile anyway. -->
  <!--
  <key>EnvironmentVariables</key>
  <dict>
    <key>JARVIS_HUB</key><string>__HOME__/jarvis-hub</string>
  </dict>
  -->
</dict>
</plist>
